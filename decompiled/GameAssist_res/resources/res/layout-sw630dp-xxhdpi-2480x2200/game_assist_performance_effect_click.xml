<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="top|right"
        android:orientation="horizontal"
        android:id="@+id/game_assist_performance_effect_expand"
        android:paddingRight="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="145dp"
        android:layout_marginRight="13dp"
        android:layout_marginBottom="28dp">
        <View
            android:id="@+id/game_assist_performance_effect_expand_custome"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="22dp"
            android:layout_marginRight="2dp"
            android:layout_weight="1"/>
        <View
            android:id="@+id/game_assist_performance_effect_expand_awakening"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginTop="34dp"
            android:layout_marginRight="2dp"
            android:layout_weight="1"/>
        <View
            android:id="@+id/game_assist_performance_effect_expand_balance"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginTop="46dp"
            android:layout_marginRight="2dp"
            android:layout_weight="1"/>
        <View
            android:id="@+id/game_assist_performance_effect_expand_economize"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginTop="58dp"
            android:layout_marginRight="2dp"
            android:layout_marginBottom="1dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <View
        android:layout_gravity="bottom|right"
        android:id="@+id/game_assist_performance_effect_button"
        android:layout_width="36dp"
        android:layout_height="80dp"/>
</merge>
