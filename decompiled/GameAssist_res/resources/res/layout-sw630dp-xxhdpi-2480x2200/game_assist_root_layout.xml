<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/game_assist_root_horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/game_assist_left_panel"
            android:layout_width="360dp"
            android:layout_height="@dimen/fold_game_assist_panel_height"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_centerVertical="true">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/game_assist_buttons"
                android:paddingLeft="37.3dp"
                android:paddingTop="4dp"
                android:paddingRight="13dp"
                android:layout_width="@dimen/game_assist_buttons_width"
                android:layout_height="@dimen/game_assist_buttons_height"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true">
                <include layout="@layout/game_assist_left_panel_sub_buttons"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_switch_mode_plugin"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_switch_mode_plugin_marginTop"
                android:layout_below="@+id/game_assist_buttons">
                <include layout="@layout/layout_switch_mode_plugin"/>
                <View
                    android:background="@drawable/dividing_line_plugin"
                    android:layout_width="@dimen/plugin_dividing_line_width"
                    android:layout_height="@dimen/plugin_dividing_line_height"
                    android:layout_marginTop="@dimen/plugin_dividing_line_marginTop"
                    android:layerType="software"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="bottom|left"
                android:orientation="vertical"
                android:id="@+id/game_assist_plugins_container"
                android:layout_width="@dimen/game_assist_plugins_width"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/layout_switch_mode_plugin_marginStart"
                android:layout_marginTop="@dimen/game_assist_plugins_container_marginTop"
                android:layout_marginBottom="@dimen/item_tile_plugin_margin_top"
                android:layout_below="@+id/layout_switch_mode_plugin"
                android:layout_alignParentLeft="true"
                android:layout_alignParentBottom="true">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/game_assist_plugins_list"
                        android:visibility="invisible"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/game_assist_plugins_card"
                        android:visibility="invisible"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </FrameLayout>
                <ImageView
                    android:id="@+id/game_assist_plugins_edit"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="38dp"
                    android:src="@drawable/game_assist_plugins_normal"
                    android:scaleType="fitXY"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/game_assist_bright_seekbar_group"
                android:paddingLeft="10dp"
                android:paddingTop="15dp"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="141dp"
                android:layout_marginTop="212dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true">
                <cn.nubia.gameassist.view.StairSeekBar
                    android:id="@+id/game_assist_bright_seekbar"
                    android:layout_width="match_parent"
                    android:layout_height="83dp"
                    android:layout_marginLeft="2dp"
                    android:layout_marginBottom="1dp"
                    android:layout_weight="1"
                    app:align="align_left"
                    app:stair_count="15"/>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginLeft="-2dp"
                    android:src="@drawable/game_assist_bright_icon"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/game_assist_cpu_neon_lamp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentLeft="true"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/game_assist_cup_effect"
                android:paddingLeft="60dp"
                android:paddingTop="81dp"
                android:paddingRight="60dp"
                android:paddingBottom="60dp"
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:layout_marginLeft="66dp"
                android:layout_marginTop="-62dp"
                android:layout_below="@+id/game_assist_buttons"
                android:layout_alignParentLeft="true"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/game_assist_cpu_launch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentLeft="true"/>
            <FrameLayout
                android:orientation="vertical"
                android:id="@+id/game_assist_performance_effect_legacy"
                android:paddingRight="5dp"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_marginLeft="95dp"
                android:layout_marginTop="-55dp"
                android:layout_below="@+id/game_assist_cup_effect"
                android:layout_alignParentLeft="true">
                <include layout="@layout/game_assist_performance_effect_show_legacy"/>
            </FrameLayout>
            <FrameLayout
                android:orientation="vertical"
                android:id="@+id/game_assist_performance_effect"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginLeft="67dp"
                android:layout_marginTop="-60dp"
                android:layout_marginBottom="@dimen/game_assist_performance_effect_margin_bottom"
                android:layout_below="@+id/game_assist_cup_effect"
                android:layout_alignParentLeft="true">
                <include layout="@layout/game_assist_performance_effect_show"/>
            </FrameLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/game_assist_right_panel"
            android:layout_width="360dp"
            android:layout_height="@dimen/fold_game_assist_panel_height"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/game_assist_pips"
                android:paddingLeft="13dp"
                android:paddingTop="4dp"
                android:paddingRight="13dp"
                android:layout_width="@dimen/game_assist_buttons_width"
                android:layout_height="@dimen/game_assist_buttons_height"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true">
                <include layout="@layout/game_assist_right_panel_pip_buttons"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="bottom|right"
                android:orientation="vertical"
                android:id="@+id/game_assist_recycler_group"
                android:layout_width="122dp"
                android:layout_height="match_parent"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="@dimen/item_tile_plugin_margin_top"
                android:minWidth="150dp"
                android:layout_below="@+id/game_assist_pips"
                android:layout_alignParentRight="true">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/game_assist_dessert"
                        android:layout_width="116dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="9dp"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/game_assist_pip_recycler"
                        android:visibility="gone"
                        android:layout_width="116dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="9dp"/>
                </FrameLayout>
                <ImageView
                    android:id="@+id/iv_edit_order"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="38dp"
                    android:src="@drawable/game_assist_recycler_normal"
                    android:scaleType="fitXY"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/game_assist_volume_seekbar_group"
                android:paddingTop="15dp"
                android:paddingRight="10dp"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="212dp"
                android:layout_marginRight="138dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true">
                <cn.nubia.gameassist.view.StairSeekBar
                    android:id="@+id/game_assist_volume_seekbar"
                    android:layout_width="match_parent"
                    android:layout_height="83dp"
                    android:layout_marginRight="2dp"
                    android:layout_marginBottom="1dp"
                    android:layout_weight="1"
                    app:align="align_right"
                    app:stair_count="15"/>
                <ImageView
                    android:layout_gravity="right"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginRight="-2dp"
                    android:src="@drawable/game_assist_volume_icon"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/game_assist_gpu_neon_lamp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/game_assist_gpu_effect"
                android:paddingLeft="60dp"
                android:paddingTop="81dp"
                android:paddingRight="60dp"
                android:paddingBottom="60dp"
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:layout_marginTop="-62dp"
                android:layout_marginRight="66dp"
                android:layout_below="@+id/game_assist_pips"
                android:layout_alignTop="@+id/game_assist_recycler_group"
                android:layout_alignParentRight="true"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/game_assist_gpu_launch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"/>
            <FrameLayout
                android:id="@+id/game_assist_meditation_mode"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginTop="-55dp"
                android:layout_marginRight="60dp"
                android:layout_below="@+id/game_assist_gpu_effect"
                android:layout_alignParentRight="true">
                <include layout="@layout/game_assist_meditation_show"/>
            </FrameLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/game_assist_middle_panel"
            android:layout_width="360dp"
            android:layout_height="60dp"
            android:layout_marginBottom="64dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true">
            <include layout="@layout/game_assist_middle_sub"/>
        </RelativeLayout>
    </RelativeLayout>
</FrameLayout>
