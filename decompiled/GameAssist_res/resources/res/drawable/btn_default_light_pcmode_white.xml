<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="0dp"
    android:insetRight="0dp"
    android:insetTop="0dp"
    android:insetBottom="0dp">
    <item
        android:state_pressed="true"
        android:drawable="@drawable/btn_pcmode_shape_pressed_white"/>
    <item
        android:state_enabled="false"
        android:drawable="@drawable/btn_pcmode_shape_disable_white"/>
    <item
        android:drawable="@drawable/btn_pcmode_shape_hovered_white"
        android:state_hovered="true"/>
    <item android:drawable="@drawable/btn_pcmode_shape_default_white"/>
</selector>
