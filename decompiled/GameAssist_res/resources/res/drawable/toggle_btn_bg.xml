<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="false"
        android:state_checked="true">
        <bitmap
            android:src="@drawable/toggle_selected"
            android:alpha="@dimen/nubia_disabled_alpha_light"/>
    </item>
    <item android:state_enabled="false">
        <bitmap
            android:src="@drawable/toggle_no_selected"
            android:alpha="@dimen/nubia_disabled_alpha_light"/>
    </item>
    <item
        android:state_checked="true"
        android:drawable="@drawable/toggle_selected"/>
    <item android:drawable="@drawable/toggle_no_selected"/>
</selector>
