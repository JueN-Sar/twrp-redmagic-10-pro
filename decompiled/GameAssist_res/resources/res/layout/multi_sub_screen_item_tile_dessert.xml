<?xml version="1.0" encoding="utf-8"?>
<cn.nubia.multisubscreen.view.MultiSubScreenTileView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_tile_dessert"
    android:layout_width="@dimen/multi_sub_screen_tile_view_w"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/multi_sub_screen_tile_view_margin_t"
    android:layout_marginBottom="@dimen/multi_sub_screen_tile_view_margin_b">
    <ImageView
        android:gravity="center"
        android:id="@+id/multi_sub_screen_tile_icon"
        android:layout_width="@dimen/multi_sub_screen_tile_icon_w"
        android:layout_height="@dimen/multi_sub_screen_tile_icon_w"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/multi_sub_screen_tile_label_text_size"
        android:gravity="center"
        android:id="@+id/multi_sub_screen_tile_lable"
        android:layout_width="@dimen/multi_sub_screen_tile_label_w"
        android:layout_height="@dimen/multi_sub_screen_tile_label_h"
        android:layout_marginTop="@dimen/multi_sub_screen_tile_label_margin_t"
        android:layout_below="@+id/multi_sub_screen_tile_icon"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/multi_sub_screen_tile_icon_badge"
        android:visibility="gone"
        android:layout_width="@dimen/multi_sub_screen_tile_badge_icon_w"
        android:layout_height="@dimen/multi_sub_screen_tile_badge_icon_w"
        android:src="@drawable/game_assist_badge"
        android:layout_toRightOf="@+id/multi_sub_screen_tile_lable"
        android:layout_alignBottom="@+id/multi_sub_screen_tile_lable"/>
</cn.nubia.multisubscreen.view.MultiSubScreenTileView>
