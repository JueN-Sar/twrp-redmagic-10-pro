<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/card_title_view"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_card_content"
        android:paddingTop="@dimen/moment_card_content_pt"
        android:paddingBottom="@dimen/moment_card_content_pb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/tv_card_title">
        <cn.nubia.screensaver.view.MomentBanner
            android:id="@+id/mv_banner"
            android:background="@drawable/shape_card_moment_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/moment_card_bottom_height">
            <ImageView
                android:layout_gravity="bottom|center_horizontal"
                android:layout_width="@dimen/moment_card_bottom_efficacy_width"
                android:layout_height="@dimen/moment_card_bottom_efficacy_height"
                android:src="@drawable/screen_saver_moment_bottom_efficacy"/>
            <cn.nubia.gameassist.view.YouSheTextView
                android:textSize="24dp"
                android:textColor="#ff7efff6"
                android:ellipsize="end"
                android:gravity="bottom|center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_app_name"
                android:layout_width="@dimen/moment_card_bottom_name_text_width"
                android:layout_height="match_parent"
                android:maxLines="2"
                android:shadowColor="#30ffffff"
                android:shadowDx="3"
                android:shadowDy="3"
                android:shadowRadius="6"
                android:lineSpacingMultiplier="0.8"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="2dp"
                android:autoSizeMinTextSize="16dp"
                android:autoSizeMaxTextSize="24dp"/>
        </FrameLayout>
        <cn.nubia.gameassist.view.YouSheTextView
            android:textSize="16dp"
            android:textColor="@color/white"
            android:id="@+id/tv_bottom_tag"
            android:paddingTop="@dimen/moment_card_bottom_name_tag_pt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mode_redmiagic_time"/>
    </LinearLayout>
</RelativeLayout>
