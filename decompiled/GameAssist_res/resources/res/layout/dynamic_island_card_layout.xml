<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/dynamic_island_card_layout"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:paddingHorizontal="32dp">
    <include
        android:layout_gravity="start|center_vertical"
        android:id="@+id/mydynamic_island_left_icon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        layout="@layout/dynamic_island_icon_layout"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/title_area"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingHorizontal="8dp">
        <TextView
            android:textSize="22sp"
            android:textColor="#e6000000"
            android:id="@+id/primary_title"
            android:scrollbars="none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="13588888888"
            android:overScrollMode="never"
            android:fontFamily="@string/font_family_systemdefault_medium"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#8a000000"
            android:ellipsize="end"
            android:id="@+id/secondary_title"
            android:scrollbars="none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="陕西西安 移动"
            android:overScrollMode="never"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/right_icon_area"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <include
            android:layout_gravity="center_vertical"
            android:id="@+id/mydynamic_island_middle_icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            layout="@layout/dynamic_island_icon_layout"/>
        <include
            android:layout_gravity="center_vertical"
            android:id="@+id/mydynamic_island_right_icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginLeft="8dp"
            layout="@layout/dynamic_island_icon_layout"/>
    </LinearLayout>
</LinearLayout>
