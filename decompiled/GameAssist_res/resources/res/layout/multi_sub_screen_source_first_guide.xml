<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#ff0a0b12"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/multi_sub_screen_first_guide_title"
        android:background="#ff2e313f"
        android:layout_width="match_parent"
        android:layout_height="@dimen/multi_sub_screen_source_aty_title_panel_h"
        android:layout_alignParentTop="true">
        <ImageView
            android:id="@+id/multi_sub_screen_first_guide_back"
            android:layout_width="@dimen/multi_sub_screen_source_aty_back_w"
            android:layout_height="match_parent"
            android:src="@drawable/multi_subscreen_source_back"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/multi_sub_screen_source_aty_title_text_size"
            android:textStyle="bold"
            android:textColor="#d9ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/multi_sub_screen_source_aty_title_margin_t"
            android:text="@string/ic_qs_multi_subscreen"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/multi_sub_screen_source_aty_title_margin_s"
            android:layout_toEndOf="@+id/multi_sub_screen_first_guide_back"/>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="@dimen/multi_sub_screen_source_first_guide_image_w"
        android:layout_height="@dimen/multi_sub_screen_source_first_guide_image_h"
        android:layout_marginTop="@dimen/multi_sub_screen_source_first_guide_image_margin_t"
        android:src="@drawable/multi_subscreen_first_guide"
        android:scaleType="fitXY"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/multi_sub_screen_source_first_guide_text_size"
            android:textColor="#ffffffff"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/multi_subscreen_first_guide_introduce"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/multi_sub_screen_source_first_guide_text_size"
        android:textStyle="bold"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/multi_sub_screen_first_guide_finish"
        android:background="@drawable/multi_sub_screen_connet_device_btn_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/multi_sub_screen_source_first_guide_finish_margin_b"
        android:text="@string/multi_subscreen_first_guide_finish"/>
</LinearLayout>
