<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/gameratio_guide_item_padding_horizontal"
    android:paddingEnd="@dimen/gameratio_guide_item_padding_horizontal">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/src"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/dest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gameratio_guide_msg_top">
            <TextView
                android:textSize="@dimen/gameratio_guide_msg_text_size"
                android:textColor="#d8ffffff"
                android:id="@+id/msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/gameratio_guide_summary_text_size"
                android:textColor="#80ffffff"
                android:id="@+id/summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gameratio_guide_summary_margin_top"
                android:text="@string/gameratio_help_summary"
                android:layout_below="@+id/msg"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </FrameLayout>
</RelativeLayout>
