<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#ff1b1c25"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.zte.plugin.reminder.WheelView
            android:id="@+id/month_day_spinner"
            android:layout_width="@dimen/game_reminder_time_piacker_wheel_month_width"
            android:layout_height="wrap_content"
            android:layout_marginEnd="0dp"/>
        <com.zte.plugin.reminder.WheelView
            android:id="@+id/hour_spinner"
            android:layout_width="@dimen/game_reminder_time_piacker_wheel_hour_width"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/month_day_spinner"/>
        <com.zte.plugin.reminder.WheelView
            android:id="@+id/minute_spinner"
            android:layout_width="@dimen/game_reminder_time_piacker_wheel_minute_width"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_toEndOf="@+id/hour_spinner"/>
        <TextView
            android:id="@+id/nubia_time_hour_textview"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:layout_alignEnd="@+id/month_day_spinner"/>
        <TextView
            android:textSize="@dimen/game_reminder_time_piacker_wheel_text_size"
            android:textColor="#ffffffff"
            android:paddingBottom="@dimen/game_reminder_time_piacker_wheel_text_padding_b"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nubia_time_hour"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/game_reminder_time_piacker_wheel_text_margin_s"
            android:layout_toEndOf="@+id/hour_spinner"/>
        <TextView
            android:textSize="@dimen/game_reminder_time_piacker_wheel_text_size"
            android:textColor="#ffffffff"
            android:paddingBottom="@dimen/game_reminder_time_piacker_wheel_text_padding_b"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nubia_time_minute"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/game_reminder_time_piacker_wheel_text_margin_s"
            android:layout_toEndOf="@+id/minute_spinner"/>
    </RelativeLayout>
</FrameLayout>
