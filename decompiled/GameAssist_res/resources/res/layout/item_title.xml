<?xml version="1.0" encoding="utf-8"?>
<cn.nubia.gameassist.dessert.TileView xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/arrow"
    android:layout_width="62.66dp"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/game_tiles_marginBottom">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/tile_icon"
        android:layout_width="@dimen/game_pip_icon_size"
        android:layout_height="@dimen/game_pip_icon_size"/>
    <TextView
        android:textSize="@dimen/game_tile_text_size"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tile_lable"
        android:layout_width="46dp"
        android:layout_height="@dimen/game_tile_label_height"
        android:layout_marginTop="@dimen/game_tile_label_layout_marginTop"/>
</cn.nubia.gameassist.dessert.TileView>
