<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/host_performance_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <cn.nubia.hostassist.HostPerformanceCircleView
            android:id="@+id/performance_view_cpu"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="8dp"
            app:isCpuType="true"
            app:text="CPU"/>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <cn.nubia.gameassist.dessert.policy.performancemonitor.PerformanceMonitorClock
                android:textSize="5dp"
                android:textColor="#ffd7d7d7"
                android:gravity="center_horizontal"
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginTop="10dp"
                android:layout_centerHorizontal="true"/>
            <cn.nubia.hostassist.HostPerformanceBgView
                android:id="@+id/performance_bg"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:id="@+id/logo"
                android:layout_width="23dp"
                android:layout_height="2dp"
                android:layout_marginTop="23dp"
                android:src="@drawable/performance_logo_host_port"
                android:layout_centerHorizontal="true"/>
            <RelativeLayout
                android:orientation="horizontal"
                android:layout_width="35dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="33dp">
                <cn.nubia.gameassist.performance.PerformanceStatusView
                    android:textSize="3dp"
                    android:textColor="#ffd7d7d7"
                    android:id="@+id/electricity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/battery_icon_host"
                    android:layout_marginStart="4dp"
                    app:isBatteryLevelType="true"/>
                <cn.nubia.gameassist.performance.PerformanceStatusView
                    android:textSize="3dp"
                    android:textColor="#ffd7d7d7"
                    android:id="@+id/net_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/netspeed_icon_host"
                    android:layout_marginStart="15dp"
                    app:isBatteryLevelType="false"/>
            </RelativeLayout>
        </RelativeLayout>
        <cn.nubia.hostassist.HostPerformanceCircleView
            android:id="@+id/performance_view_gpu"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            app:isCpuType="false"
            app:text="GPU"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:background="@drawable/radio_button_bg"
        android:layout_width="100dp"
        android:layout_height="12dp"
        android:layout_marginTop="4dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/nubia_game_performance_group"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <cn.nubia.gameassist.performance.NubiaPerformanceRadioButton
                android:textColor="@drawable/nubia_performance_balance_text_color"
                android:id="@+id/nubia_game_strength_performance_balance"
                android:layout_width="17dp"
                android:layout_height="12dp"
                android:text="@string/nubia_game_performance_mode_0"
                app:bottomIcon="@drawable/icon_endurance_host"
                style="@style/RadioButtonStyle"/>
            <cn.nubia.gameassist.performance.NubiaPerformanceRadioButton
                android:textColor="@drawable/nubia_performance_rise_text_color"
                android:id="@+id/nubia_game_strength_performance_rise"
                android:layout_width="17dp"
                android:layout_height="12dp"
                android:text="@string/nubia_game_performance_mode_1"
                app:bottomIcon="@drawable/icon_balance_host"
                style="@style/RadioButtonStyle"/>
            <cn.nubia.gameassist.performance.NubiaPerformanceRadioButton
                android:textColor="@drawable/nubia_performance_beyond_text_color"
                android:id="@+id/nubia_game_strength_performance_beyond"
                android:layout_width="17dp"
                android:layout_height="12dp"
                android:text="@string/nubia_game_performance_mode_2"
                app:bottomIcon="@drawable/icon_gaming_host"
                style="@style/RadioButtonStyle"/>
            <cn.nubia.gameassist.performance.NubiaPerformanceRadioButton
                android:textColor="@drawable/nubia_performance_infinite_text_color"
                android:id="@+id/nubia_game_strength_performance_infinite"
                android:visibility="gone"
                android:layout_width="17dp"
                android:layout_height="12dp"
                android:text="@string/nubia_game_performance_mode_3"
                style="@style/RadioButtonStyle"/>
            <cn.nubia.gameassist.performance.NubiaPerformanceRadioButton
                android:textColor="@drawable/nubia_performance_custom_text_color"
                android:id="@+id/nubia_game_strength_performance_custom"
                android:visibility="gone"
                android:layout_width="17dp"
                android:layout_height="12dp"
                android:text="@string/ic_qs_custome"
                app:bottomIcon="@drawable/icon_custom_host"
                style="@style/RadioButtonStyle"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/diablo_mode_group"
            android:background="@drawable/radio_button_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="4dp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@+id/diablo_mode_tile"
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="@string/nubia_game_performance_mode_diablo_title"
                android:singleLine="true"
                android:layout_marginStart="3dp"/>
            <TextView
                android:textSize="3dp"
                android:textColor="#ffffffff"
                android:id="@+id/diablo_mode_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/nubia_game_performance_mode_diablo_content"
                android:singleLine="true"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"/>
            <ImageButton
                android:id="@+id/diablo_mode_button"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/diablo_thumb_host"
                android:layout_marginEnd="3dp"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
