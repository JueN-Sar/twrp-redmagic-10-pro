<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/noti_msg_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/noti_msg_pkg_info_container"
        android:paddingTop="@dimen/multi_sub_screen_noti_msg_pkg_info_container_padding_t"
        android:paddingBottom="@dimen/multi_sub_screen_noti_msg_pkg_info_container_padding_b"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/multi_sub_screen_noti_msg_pkg_info_container_margin_s"
        android:layout_marginEnd="@dimen/multi_sub_screen_noti_msg_pkg_info_container_margin_e">
        <ImageView
            android:id="@+id/noti_msg_pkg_icon"
            android:layout_width="@dimen/multi_sub_screen_noti_msg_pkg_icon_w"
            android:layout_height="@dimen/multi_sub_screen_noti_msg_pkg_icon_h"
            android:src="@drawable/multi_sub_screen_noti_msg_pkg_icon"
            android:layout_marginEnd="@dimen/multi_sub_screen_noti_msg_pkg_icon_margin_e"/>
        <TextView
            android:textSize="@dimen/multi_sub_screen_noti_msg_pkg_name_tv_size"
            android:textColor="@color/multi_subscreen_noti_msg_pkg_name_tv_color"
            android:id="@+id/noti_msg_pkg_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/noti_msg_content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/multi_sub_screen_noti_msg_content_container_margin_t"
        android:layout_marginBottom="@dimen/multi_sub_screen_noti_msg_content_container_margin_b"
        android:layout_marginStart="@dimen/multi_sub_screen_noti_msg_content_container_margin_s"
        android:layout_marginEnd="@dimen/multi_sub_screen_noti_msg_content_container_margin_e">
        <TextView
            android:textSize="@dimen/multi_sub_screen_noti_msg_title_tv_size"
            android:textColor="@color/multi_subscreen_noti_msg_title_tv_color"
            android:id="@+id/noti_msg_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/multi_sub_screen_noti_msg_time_tv_size"
            android:textColor="@color/multi_subscreen_noti_msg_time_tv_color"
            android:gravity="top"
            android:id="@+id/noti_msg_time"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="@dimen/multi_sub_screen_noti_msg_content_tv_size"
            android:textColor="@color/multi_subscreen_noti_msg_content_tv_color"
            android:id="@+id/noti_msg_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/noti_msg_title"
            android:layout_marginEnd="@dimen/multi_sub_screen_noti_msg_content_margin_e"
            android:layout_toStartOf="@+id/noti_msg_time"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/noti_msg_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/multi_sub_screen_noti_msg_divider_h"
        android:layout_marginTop="@dimen/multi_sub_screen_noti_msg_divider_margin_t"
        android:src="@color/multi_subscreen_noti_msg_divider_color"
        android:layout_marginStart="@dimen/multi_sub_screen_noti_msg_divider_margin_s"
        android:layout_marginEnd="@dimen/multi_sub_screen_noti_msg_divider_margin_e"/>
</LinearLayout>
