<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/dynamic_island_card_layout"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="68dp">
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/hourglass"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginLeft="13dp"
        android:forceDarkAllowed="false"
        app:lottie_autoPlay="true"
        app:lottie_fileName="hourglass.json"
        app:lottie_loop="true"
        app:lottie_progress="0"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/title_area"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingHorizontal="8dp">
        <TextView
            android:textSize="17sp"
            android:textColor="#e6000000"
            android:id="@+id/primary_title"
            android:scrollbars="none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="99小时99分99秒已到时间"
            android:overScrollMode="never"
            android:fontFamily="@string/font_family_systemdefault_medium"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#8a000000"
            android:ellipsize="end"
            android:id="@+id/secondary_title"
            android:scrollbars="none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已超时 00:00:02"
            android:overScrollMode="never"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/right_icon_area"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="13dp">
        <include
            android:layout_gravity="center_vertical"
            android:id="@+id/mydynamic_island_right_icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            layout="@layout/dynamic_island_icon_layout"/>
    </LinearLayout>
</LinearLayout>
