<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/charge_separation_touch_toast_bg"
    android:paddingLeft="18dp"
    android:paddingTop="8.5dp"
    android:paddingBottom="8.5dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="18dp">
    <TextView
        android:textSize="14dp"
        android:textColor="#ffffffff"
        android:layout_gravity="center_vertical"
        android:id="@+id/charge_separation_toast_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="50dp"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#ffcecece"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/charge_separation_toast_jump"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="36dp"
        android:text="@string/game_charge_separation_setting"/>
</FrameLayout>
