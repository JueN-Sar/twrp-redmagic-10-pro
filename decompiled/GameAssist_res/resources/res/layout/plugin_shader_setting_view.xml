<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/plugin_shader_setting"
    android:background="@drawable/gameshader_setting_bg"
    android:paddingLeft="20dp"
    android:paddingRight="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/plugin_shader_setting_title"
        android:layout_width="match_parent"
        android:layout_height="42dp">
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffffff"
            android:id="@+id/plugin_shader_setting_title_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gameshader_title_full"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/plugin_gameshader_setting_title_margin_left"/>
        <ImageView
            android:id="@+id/plugin_shader_setting_close"
            android:layout_width="@dimen/plugin_gameshader_setting_close_size"
            android:layout_height="@dimen/plugin_gameshader_setting_close_size"
            android:src="@drawable/gameshader_setting_close"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <cn.nubia.plugin.gameshader.ShaderSettingListView
        android:scrollbarThumbVertical="@drawable/gameshader_list_scrollbar_background"
        android:id="@+id/plugin_shader_setting_listview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:layout_below="@+id/plugin_shader_setting_title"/>
</RelativeLayout>
