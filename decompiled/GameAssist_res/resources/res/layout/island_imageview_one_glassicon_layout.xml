<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dynamic_island_timer_card_root"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="68dp">
    <FrameLayout
        android:id="@+id/left_imageview_root"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="13dp"
        android:layout_alignParentStart="true">
        <ImageButton
            android:layout_gravity="center"
            android:id="@+id/left_imageview"
            android:background="@color/md__transparent"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/close"
            android:tint="@color/mfvc_primary_main_color"/>
        <ImageButton
            android:layout_gravity="end|bottom"
            android:id="@+id/left_imageview_small"
            android:background="@color/md__transparent"
            android:visibility="gone"
            android:layout_width="16.8dp"
            android:layout_height="16.8dp"
            android:layout_marginBottom="4.2dp"
            android:src="@drawable/close"/>
    </FrameLayout>
    <include
        android:id="@+id/right_icon_2"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_centerVertical="true"
        android:layout_marginEnd="13dp"
        android:layout_alignParentEnd="true"
        layout="@layout/dynamic_island_icon_layout"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/timer_text_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/right_icon_2"
        android:layout_toEndOf="@+id/left_imageview_root">
        <TextView
            android:textSize="22sp"
            android:textColor="#e6000000"
            android:ellipsize="end"
            android:id="@+id/timer_primary_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="13512345678"
            android:maxLines="1"
            android:fontFamily="@string/font_family_systemdefault_medium"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#8a000000"
            android:ellipsize="end"
            android:id="@+id/timer_secondary_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="陕西西安移动"
            android:maxLines="1"
            android:fontFamily="@string/font_family_systemdefault_medium"/>
    </LinearLayout>
</RelativeLayout>
