<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:background="@drawable/game_reminder_widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/reminder_title_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6.67dp"
        android:layout_marginStart="8dp">
        <ImageView
            android:id="@+id/reminder_widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/reminder_title_content_bg"/>
        <ImageView
            android:id="@+id/reminder_widget_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/game_reminder_icon_widget"
            android:layout_marginEnd="8dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/reminder_list_panel_widget"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/reminder_title_content">
        <ListView
            android:scrollbarSize="3dp"
            android:scrollbarThumbVertical="@drawable/game_reminder_widget_list_scrollbar_background"
            android:scrollbarStyle="insideOverlay"
            android:id="@+id/reminder_list_widget"
            android:fadingEdgeLength="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="1dp"
            android:listSelector="@android:color/transparent"
            android:drawSelectorOnTop="false"
            android:divider="@null"
            style="?android:attr/listViewWhiteStyle"/>
        <TextView
            android:textSize="@dimen/game_reminder_empty_widget_text_size"
            android:textColor="@color/game_reminder_widget_empty_text_color"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/reminder_empty_widget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.67dp"
            android:text="@string/game_reminder_widget_empty"
            android:maxLines="3"
            android:layout_marginStart="@dimen/game_reminder_empty_widget_margin"
            android:layout_marginEnd="@dimen/game_reminder_empty_widget_margin"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/reminder_empty_icon_widget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/game_reminder_empty_widget"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
