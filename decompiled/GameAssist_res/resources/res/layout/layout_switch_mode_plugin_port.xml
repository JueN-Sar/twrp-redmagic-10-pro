<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RadioGroup
        android:orientation="vertical"
        android:id="@+id/switch_plugin_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <cn.nubia.gameassist.plugin.panel.PluginRadioButton
            android:id="@+id/switch_plugin_list"
            android:paddingTop="@dimen/pluginRadioButton_padding_port"
            android:layout_width="@dimen/switch_plugin_list_height"
            android:layout_height="@dimen/switch_plugin_list_width"
            android:button="@null"
            android:drawableStart="@drawable/selector_swith_mode_plugin_list_economize"
            android:paddingStart="@dimen/pluginRadioButton_padding_start"
            app:switchType="0"/>
        <cn.nubia.gameassist.plugin.panel.PluginRadioButton
            android:id="@+id/switch_plugin_card"
            android:paddingTop="@dimen/pluginRadioButton_padding_port"
            android:layout_width="@dimen/switch_plugin_list_height"
            android:layout_height="@dimen/switch_plugin_list_width"
            android:button="@null"
            android:drawableStart="@drawable/selector_swith_mode_plugin_card_economize"
            android:paddingStart="@dimen/pluginRadioButton_padding_start"
            app:switchType="1"/>
    </RadioGroup>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sort_plugin_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pluginRadioButton_padding_port">
        <ImageButton
            android:id="@+id/sort_plugin_btn"
            android:background="@drawable/button_plugin_sort_bg_port"
            android:layout_width="@dimen/switch_plugin_list_height"
            android:layout_height="@dimen/switch_plugin_list_width"
            android:src="@drawable/ic_card_plugin_sort"
            android:scaleType="centerInside"/>
        <ImageButton
            android:id="@+id/switch_plugin_btn"
            android:background="@drawable/button_plugin_list_bg_port"
            android:layout_width="@dimen/switch_plugin_list_height"
            android:layout_height="@dimen/switch_plugin_list_width"
            android:layout_marginTop="@dimen/switch_plugin_list_margin_start"
            android:src="@drawable/ic_plugin_sort_list"/>
    </LinearLayout>
</merge>
