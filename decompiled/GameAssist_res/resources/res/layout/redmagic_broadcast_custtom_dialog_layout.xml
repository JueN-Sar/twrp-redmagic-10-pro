<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="17dp"
        android:textColor="@color/manual_record_title_color"
        android:gravity="left"
        android:id="@+id/delete_dialog_title"
        android:paddingLeft="27dp"
        android:paddingRight="27dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ic_qs_red_magic_broadcast_content_text"
        android:elegantTextHeight="true"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/manual_record_prompt_color"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:paddingLeft="27dp"
        android:paddingRight="27dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="20dp"
        android:text="@string/ic_qs_red_magic_broadcast_prompt_text"/>
</LinearLayout>
