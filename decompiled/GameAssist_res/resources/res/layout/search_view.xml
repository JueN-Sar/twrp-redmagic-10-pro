<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/search_bar"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="?android:attr/textColorPrimary"
        android:gravity="center_vertical"
        android:id="@+id/search_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:drawablePadding="0dp"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/search_button"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@null"
        android:contentDescription="@string/searchview_description_search"
        style="?android:attr/actionButtonStyle"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/search_edit_frame"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5.5dp"
        android:layout_marginBottom="5.5dp"
        android:layout_weight="1"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/search_mag_icon"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:src="@null"
            android:scaleType="centerInside"
            android:contentDescription="@string/searchview_description_search"
            android:layout_marginStart="0dp"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/search_plate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <view
                android:textSize="@dimen/mfvc_primary_font_size"
                android:textColor="@color/mfv_common_acb_tf_txt"
                android:textColorHint="@color/mfv_common_acb_tf_txt_watermark"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/search_src_text"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:minWidth="160dp"
                android:maxLines="1"
                android:layout_weight="1"
                android:inputType="textNoSuggestions"
                android:dropDownAnchor="@+id/search_edit_frame"
                android:imeOptions="actionSearch"
                android:dropDownHeight="wrap_content"
                android:dropDownHorizontalOffset="0dp"
                android:dropDownVerticalOffset="0dp"
                android:textCursorDrawable="@null"
                android:paddingStart="0.25dp"
                android:paddingEnd="0.25dp"
                class="com.zte.mifavor.widget.SearchViewZTE$SearchAutoComplete"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/search_close_btn"
                android:background="?android:attr/selectableItemBackground"
                android:padding="3dp"
                android:focusable="true"
                android:layout_width="@dimen/mfvc_ic_medium_width"
                android:layout_height="@dimen/mfvc_ic_medium_width"
                android:tint="@color/mfv_common_acb_tf_ic"
                android:contentDescription="@string/searchview_description_clear"
                android:tintMode="src_in"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/search_voice_iv"
                android:background="?android:attr/selectableItemBackground"
                android:padding="4dp"
                android:focusable="true"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/voice_assistance"
                android:tint="@color/mfv_common_btn_txt_default"
                android:contentDescription="@string/searchview_description_voice"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/submit_area"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <ImageButton
                android:layout_gravity="center_vertical"
                android:id="@+id/search_go_btn"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:contentDescription="@string/searchview_description_submit"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/search_voice_btn"
                android:background="?android:attr/selectableItemBackground"
                android:focusable="true"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/ic_voice_search_api_holo_light"
                android:contentDescription="@string/searchview_description_voice"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
