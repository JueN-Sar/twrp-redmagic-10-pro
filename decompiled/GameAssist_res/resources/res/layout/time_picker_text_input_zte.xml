<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:id="@+id/input_block"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <com.zte.mifavor.widget.TextViewZTE
        android:textSize="18sp"
        android:textColor="#ff000000"
        android:id="@+id/time_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/time_label"/>
    <com.zte.mifavor.widget.EditTextZTE
        android:textSize="20sp"
        android:textColor="#ff000000"
        android:gravity="center"
        android:id="@+id/input_hour"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:selectAllOnFocus="true"
        android:inputType="number"
        android:imeOptions="actionNext"
        android:layout_marginStart="24dp"/>
    <com.zte.mifavor.widget.TextViewZTE
        android:textSize="20sp"
        android:textColor="#ff000000"
        android:id="@+id/input_separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=":"
        android:layout_marginStart="10dp"/>
    <com.zte.mifavor.widget.EditTextZTE
        android:textSize="20sp"
        android:textColor="#ff000000"
        android:gravity="center"
        android:id="@+id/input_minute"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:selectAllOnFocus="true"
        android:inputType="number"
        android:layout_marginStart="10dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp">
        <ImageButton
            android:id="@+id/increment"
            android:background="@drawable/arrow_up_pcmode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageButton
            android:id="@+id/decrement"
            android:background="@drawable/arrow_down_pcmode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
    </LinearLayout>
    <Spinner
        android:id="@+id/am_pm_spinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"/>
</LinearLayout>
