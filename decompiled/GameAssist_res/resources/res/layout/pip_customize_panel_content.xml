<?xml version="1.0" encoding="utf-8"?>
<cn.nubia.gameassist.pips.custom.CustomPipOrder xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/tile_customize_content_title"
            android:textColor="@color/game_tile_customize_label"
            android:layout_gravity="center"
            android:paddingTop="@dimen/tile_customize_content_margin_top"
            android:paddingBottom="@dimen/tile_customize_content_margin_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/custome_title"
            android:fontFamily="NotoSansCJKsc"/>
        <FrameLayout
            android:id="@+id/fl_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/game_pip_order_list_container_ps">
            <View
                android:layout_gravity="bottom"
                android:id="@+id/horizontal_scrollbar"
                android:background="@drawable/rv_horizontal_scrollbar"
                android:visibility="invisible"
                android:layout_width="@dimen/game_pip_order_list_scrollbar_width"
                android:layout_height="4dp"
                android:translationX="@dimen/game_pip_order_list_scrollbar_ps"/>
            <cn.nubia.gameassist.view.PipOrderRecycleView
                android:layout_gravity="center"
                android:id="@+id/custom_list"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tile_customize_content_recycle_height"
                android:translationX="@dimen/tile_customize_list_container_ps"
                android:paddingStart="@dimen/game_pip_order_stable_zone_width"/>
            <cn.nubia.gameassist.pips.custom.MaskView
                android:layout_gravity="end"
                android:background="@drawable/rv_horizontal_boundary_mask"
                android:layout_width="@dimen/game_pip_order_mask_width"
                android:layout_height="@dimen/game_pip_order_list_height"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="bottom|center_horizontal"
            android:paddingBottom="@dimen/tile_customize_padding_bottom"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <Button
                android:textSize="@dimen/tile_customize_btn_size"
                android:textColor="@color/game_tile_customize_label"
                android:id="@+id/cancel_button"
                android:background="@drawable/game_custom_button"
                android:layout_width="@dimen/game_pip_order_button_width"
                android:layout_height="@dimen/tile_customize_btn_height"
                android:layout_marginRight="@dimen/tile_customize_btn_margin_right"
                android:text="@string/cancel"
                android:textAllCaps="false"/>
            <Button
                android:textSize="@dimen/tile_customize_btn_size"
                android:textColor="@color/game_tile_customize_label"
                android:id="@+id/confirm_button"
                android:background="@drawable/game_custom_button"
                android:layout_width="@dimen/game_pip_order_button_width"
                android:layout_height="@dimen/tile_customize_btn_height"
                android:text="@string/confirm"
                android:textAllCaps="false"/>
        </LinearLayout>
    </LinearLayout>
</cn.nubia.gameassist.pips.custom.CustomPipOrder>
