<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/game_assist_middle_search_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp">
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/lottie_animation"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="centerInside"
                android:layout_marginEnd="5dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/data"/>
            <ImageButton
                android:textColor="#ffffffff"
                android:id="@+id/game_assist_middle_search"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/game_assist_middle_mychatbot"
                android:scaleType="centerCrop"
                android:layout_marginEnd="5dp"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/game_assist_middle_info"
                android:background="@drawable/game_assist_info_bg"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                android:layout_marginRight="15dp">
                <ImageView
                    android:id="@+id/game_assist_icon_info"
                    android:layout_width="64dp"
                    android:layout_height="8dp"
                    android:layout_marginLeft="3dp"
                    android:src="@drawable/game_assist_info_icon"/>
                <TextView
                    android:textSize="8.7dp"
                    android:textColor="#ffffffff"
                    android:id="@+id/game_assist_time_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="5dp"
                    android:text="10:30"/>
                <ImageView
                    android:textColor="#ffffffff"
                    android:layout_width="7.5dp"
                    android:layout_height="7.5dp"
                    android:layout_marginLeft="5dp"
                    android:src="@drawable/game_assist_info_battery_icon"/>
                <TextView
                    android:textSize="8.7dp"
                    android:textColor="#ffffffff"
                    android:id="@+id/game_assist_battery_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:text="90%"/>
                <ImageView
                    android:layout_width="7.5dp"
                    android:layout_height="7.5dp"
                    android:layout_marginLeft="5dp"
                    android:src="@drawable/game_assist_info_network_icon"/>
                <TextView
                    android:textSize="8.7dp"
                    android:textColor="#ffffffff"
                    android:id="@+id/game_assist_network_speed_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:text="1.00KB/S"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/game_assist_middle_info_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/game_assist_middle_omt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="9dp"
                        android:textColor="#d9ffffff"
                        android:gravity="center"
                        android:id="@+id/game_assist_middle_one_more_thing"
                        android:background="@drawable/game_assist_one_more_thing_background"
                        android:layout_width="280dp"
                        android:layout_height="20dp"
                        android:text="one more thing"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:layout_marginEnd="5dp"/>
                    <ImageButton
                        android:layout_gravity="center_vertical"
                        android:id="@+id/game_assist_middle_thumb"
                        android:background="@color/transparent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/thumb_off"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</merge>
