<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/performance_indicator_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:background="@drawable/performance_indicator_tittle_bg"
        android:layout_width="@dimen/performance_indicator_title_img_w"
        android:layout_height="@dimen/performance_indicator_title_img_h"
        android:layout_marginTop="@dimen/performance_indicator_title_img_margin_t"
        android:layout_marginStart="@dimen/performance_indicator_title_img_margin_s"/>
    <TextView
        android:textSize="@dimen/performance_indicator_title_tv_text_size"
        android:textColor="#ffffffff"
        android:id="@+id/performance_indicator_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/performance_indicator_title_tv_margin_t"
        android:text="@string/performance_indicator_label"
        android:fontFamily="youshe-bth-stable-family"
        android:layout_marginStart="@dimen/performance_indicator_title_tv_margin_s"/>
    <TextView
        android:textSize="@dimen/performance_indicator_detected_time_tv_text_size"
        android:textColor="#8affffff"
        android:id="@+id/detected_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/performance_indicator_detected_time_tv_margin_t"
        android:text="-- -- --"
        android:layout_alignParentRight="true"
        android:fontFamily="youshe-bth-stable-family"
        android:layout_marginEnd="@dimen/performance_indicator_detected_time_tv_margin_e"/>
    <ImageView
        android:id="@+id/perf_indicator_detected_main_bg"
        android:background="@drawable/performance_indicator_no_detected_main_bg"
        android:layout_width="@dimen/performance_indicator_detected_time_main_img_w"
        android:layout_height="@dimen/performance_indicator_detected_time_main_img_h"
        android:layout_marginTop="@dimen/performance_indicator_detected_time_main_img_margin_t"
        android:scaleType="fitXY"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/base_image_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/performance_indicator_base_img_margin_e"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/performance_indicator_detected_result_tv_text_size"
        android:textColor="#ff9c9d9f"
        android:id="@+id/perf_indicator_detected_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--"
        android:layout_centerVertical="true"
        android:fontFamily="youshe-bth-stable-family"
        android:layout_marginEnd="@dimen/performance_indicator_detected_result_tv_margin_e"
        android:layout_toStartOf="@+id/base_image_view"/>
    <TextView
        android:textSize="@dimen/performance_indicator_latency_title_tv_text_size"
        android:textColor="#ffffff"
        android:id="@+id/latency_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/performance_indicator_latency_title_tv_margin_t"
        android:text="@string/performance_indicator_latency_tittle"
        android:layout_toRightOf="@+id/perf_indicator_detected_result"
        android:fontFamily="NotoSansCJKsc"/>
    <TextView
        android:textSize="@dimen/performance_indicator_latency_num_tv_text_size"
        android:textColor="#ff9c9d9f"
        android:id="@+id/latency_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/performance_indicator_latency_num_tv_margin_t"
        android:text="--ms"
        android:layout_toRightOf="@+id/latency_title"
        android:fontFamily="youshe-bth-stable-family"
        android:layout_marginStart="@dimen/performance_indicator_latency_num_tv_margin_s"/>
    <TextView
        android:textSize="@dimen/performance_indicator_jitter_title_tv_text_size"
        android:textColor="#ffffffff"
        android:id="@+id/jitter_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/performance_indicator_jitter_title_tv_margin_t"
        android:text="@string/performance_indicator_jitter_tittle"
        android:layout_toRightOf="@+id/perf_indicator_detected_result"
        android:layout_below="@+id/latency_title"
        android:fontFamily="NotoSansCJKsc"
        android:layout_alignStart="@+id/latency_title"/>
    <TextView
        android:textSize="@dimen/performance_indicator_jitter_num_tv_text_size"
        android:textColor="#ff9c9d9f"
        android:id="@+id/jitter_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/performance_indicator_jitter_num_tv_margin_t"
        android:text="--ms"
        android:layout_toRightOf="@+id/jitter_title"
        android:fontFamily="youshe-bth-stable-family"
        android:layout_marginStart="@dimen/performance_indicator_jitter_num_tv_margin_s"/>
    <ImageView
        android:id="@+id/detect_button"
        android:background="@drawable/performance_indicator_detect_button"
        android:layout_width="@dimen/performance_indicator_detect_button_tv_w"
        android:layout_height="@dimen/performance_indicator_detect_button_tv_h"
        android:layout_marginBottom="@dimen/performance_indicator_detect_button_tv_margin_b"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/performance_indicator_detect_text_tv_text_size"
        android:textColor="#ffffff"
        android:id="@+id/detect_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/performance_indicator_detect_text_tv_margin_b"
        android:text="@string/performance_indicator_detect"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:fontFamily="NotoSansCJKsc"/>
</RelativeLayout>
