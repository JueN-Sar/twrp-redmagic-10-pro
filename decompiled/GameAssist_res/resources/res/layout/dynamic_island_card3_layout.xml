<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/dynamic_island_card_layout"
    android:paddingRight="13dp"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="133dp"
    android:paddingVertical="13dp">
    <include
        android:layout_gravity="start|center_vertical"
        android:id="@+id/mydynamic_island_left_icon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginLeft="13dp"
        layout="@layout/dynamic_island_icon_layout"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/title_area"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingHorizontal="8dp">
        <TextView
            android:textSize="17sp"
            android:textColor="#e6000000"
            android:id="@+id/primary_title"
            android:scrollbars="none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="nubia 互传"
            android:overScrollMode="never"
            android:fontFamily="@string/font_family_systemdefault_medium"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#8a000000"
            android:ellipsize="end"
            android:id="@+id/secondary_title"
            android:scrollbars="none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="nubia Z80 Ultra 向你发送了12个文件共134MB，要接收吗？"
            android:overScrollMode="never"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/button_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:paddingHorizontal="2dp">
            <include
                android:id="@+id/button1"
                android:layout_width="126dp"
                android:layout_height="34dp"
                android:layout_marginHorizontal="4dp"
                layout="@layout/dynamic_island_button_layout"/>
            <include
                android:id="@+id/button2"
                android:layout_width="126dp"
                android:layout_height="34dp"
                android:layout_marginHorizontal="4dp"
                layout="@layout/dynamic_island_button_layout"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
