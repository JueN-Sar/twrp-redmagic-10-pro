<?xml version="1.0" encoding="utf-8"?>
<cn.nubia.gameassist.dessert.policy.fan.NubiaFanView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:translationY="200px"
        android:layout_marginStart="27dp"
        android:layout_marginEnd="27dp"
        android:layout_alignParentEnd="true">
        <FrameLayout
            android:layout_gravity="end|center_vertical"
            android:id="@+id/round"
            android:background="@drawable/fan_ani_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/fan_ani_center_bg"/>
            <FrameLayout
                android:id="@+id/fan_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/fan_ani_fan_bg"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/fan_ani_fan"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/fan_ani_grid"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/particle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/fan_ani_particle_bg"/>
        </FrameLayout>
    </FrameLayout>
</cn.nubia.gameassist.dessert.policy.fan.NubiaFanView>
