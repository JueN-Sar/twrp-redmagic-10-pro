<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/gamereminder_widget_list_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp">
    <RelativeLayout
        android:id="@+id/widget_list_item"
        android:background="@drawable/game_reminder_widget_list_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp">
        <ImageView
            android:id="@+id/widget_event_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:src="@drawable/game_reminder_event_delete"
            android:layout_alignParentTop="true"
            android:layout_marginStart="5.33dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/game_reminder_widget_date_time_text_color"
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:singleLine="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@+id/widget_event_icon"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/game_reminder_widget_date_time_text_color"
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:singleLine="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="2dp"
            android:layout_toEndOf="@+id/widget_date"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/game_reminder_widget_content_text_color"
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:layout_below="@+id/widget_date"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@+id/widget_event_icon"/>
    </RelativeLayout>
</LinearLayout>
