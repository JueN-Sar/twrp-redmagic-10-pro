<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <cn.nubia.gameassist.view.DiplogenFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bottom_invagination="2dp"
        app:button_index="1"
        app:center_y="4dp"
        app:left_invagination="-3dp"
        app:right_invagination="3dp"
        app:slope="slope_left"
        app:slope_width="9dp"
        app:top_invagination="3dp">
        <LinearLayout
            android:gravity="top|left"
            android:orientation="vertical"
            android:id="@+id/game_assist_performance_effect_expand"
            android:background="@drawable/game_assist_diplogen_left_expand_legacy"
            android:paddingTop="20dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="107dp"
            android:layout_marginTop="13dp">
            <cn.nubia.gameassist.view.RotationTextView
                android:textSize="10sp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@+id/game_assist_performance_effect_expand_economize"
                android:layout_width="76dp"
                android:layout_height="0dp"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="2dp"
                android:text="@string/nubia_game_performance_mode_0"
                android:layout_weight="1"/>
            <cn.nubia.gameassist.view.RotationTextView
                android:textSize="10sp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@+id/game_assist_performance_effect_expand_balance"
                android:layout_width="76dp"
                android:layout_height="0dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="2dp"
                android:text="@string/nubia_game_performance_mode_1"
                android:layout_weight="1"/>
            <cn.nubia.gameassist.view.RotationTextView
                android:textSize="10sp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@+id/game_assist_performance_effect_expand_awakening"
                android:layout_width="76dp"
                android:layout_height="0dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="1dp"
                android:text="@string/nubia_game_performance_mode_2"
                android:layout_weight="1"/>
        </LinearLayout>
    </cn.nubia.gameassist.view.DiplogenFrameLayout>
    <cn.nubia.gameassist.view.RotationTextView
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:layout_gravity="top|right"
        android:id="@+id/game_assist_performance_effect_button"
        android:background="@drawable/game_assist_diplogen_choice_economize"
        android:layout_width="80dp"
        android:layout_height="27dp"
        android:text="@string/nubia_game_performance_mode_0"/>
</merge>
