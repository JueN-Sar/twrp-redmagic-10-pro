<?xml version="1.0" encoding="utf-8"?>
<cn.nubia.gameassist.dessert.TileView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_tile_dessert"
    android:layout_width="58dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp">
    <ImageView
        android:gravity="center"
        android:id="@+id/tile_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="8dp"
        android:gravity="center"
        android:id="@+id/tile_lable"
        android:layout_width="56dp"
        android:layout_height="12dp"
        android:layout_marginTop="3dp"
        android:layout_below="@+id/tile_icon"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/tile_icon_badge"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/game_assist_badge"
        android:layout_toRightOf="@+id/tile_lable"
        android:layout_alignBottom="@+id/tile_lable"/>
</cn.nubia.gameassist.dessert.TileView>
