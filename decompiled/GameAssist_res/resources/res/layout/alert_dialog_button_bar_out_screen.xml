<?xml version="1.0" encoding="utf-8"?>
<com.zte.mifavor.widget.DialogButtonBar xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/buttonPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/mfvc_alert_dialog_button_panel_height_min"
    android:layoutDirection="locale"
    android:paddingHorizontal="15px"
    android:forceDarkAllowed="false">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.zte.mifavor.widget.ButtonZTE
            android:textAppearance="@style/mfvc_light_btn_font"
            android:textSize="28px"
            android:ellipsize="end"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/button2"
            android:background="@drawable/mfvc_dialog_button_bg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:numStars="2"
            android:maxLines="1"
            android:layout_weight="1"
            android:stateListAnimator="@null"
            android:forceDarkAllowed="false"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/divider1"
            android:visibility="gone"
            android:layout_width="15px"
            android:layout_height="wrap_content"/>
        <com.zte.mifavor.widget.ButtonZTE
            android:textAppearance="@style/mfvc_light_btn_font"
            android:textSize="28px"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/button3"
            android:background="@drawable/mfvc_dialog_button_bg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:numStars="2"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:stateListAnimator="@null"
            android:forceDarkAllowed="false"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/divider2"
            android:visibility="gone"
            android:layout_width="15px"
            android:layout_height="wrap_content"/>
        <com.zte.mifavor.widget.ButtonZTE
            android:textAppearance="@style/mfvc_light_btn_font"
            android:textSize="28px"
            android:ellipsize="end"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/button1"
            android:background="@drawable/mfvc_dialog_button_bg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:numStars="2"
            android:maxLines="1"
            android:layout_weight="1"
            android:stateListAnimator="@null"
            android:forceDarkAllowed="false"/>
    </LinearLayout>
</com.zte.mifavor.widget.DialogButtonBar>
