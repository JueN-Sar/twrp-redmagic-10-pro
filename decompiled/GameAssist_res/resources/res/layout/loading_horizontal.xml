<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/loadingHorizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zte.mifavor.widget.DialogMessage
        android:textAppearance="@style/mfvc_dialog_subheader_font"
        android:gravity="center"
        android:id="@+id/subTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:forceDarkAllowed="false"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/loadingContent"
        android:paddingLeft="32dp"
        android:paddingTop="0dp"
        android:paddingRight="@dimen/mfvc_xlarge_padding"
        android:paddingBottom="@dimen/mfvc_xlarge_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/loading"/>
        <View
            android:id="@+id/space"
            android:layout_width="16dp"
            android:layout_height="match_parent"/>
        <TextView
            android:textAppearance="@style/TextAppearance.ZTE.Light"
            android:textSize="@dimen/mfv_common_loading_txt_size2"
            android:textColor="#e5000000"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/myMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:text="正在加载中..."/>
    </LinearLayout>
</LinearLayout>
