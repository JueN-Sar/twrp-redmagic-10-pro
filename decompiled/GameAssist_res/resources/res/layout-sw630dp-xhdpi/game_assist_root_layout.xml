<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/game_assist_root_horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/game_assist_left_panel"
            android:layout_width="660dp"
            android:layout_height="match_parent"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/game_assist_buttons"
                android:paddingLeft="13dp"
                android:paddingTop="4dp"
                android:paddingRight="13dp"
                android:layout_width="360dp"
                android:layout_height="90dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true">
                <include layout="@layout/game_assist_left_panel_sub_buttons"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_switch_mode_plugin"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_switch_mode_plugin_marginTop"
                android:layout_below="@+id/game_assist_buttons">
                <include layout="@layout/layout_switch_mode_plugin"/>
                <View
                    android:background="@drawable/dividing_line_plugin"
                    android:layout_width="@dimen/plugin_dividing_line_width"
                    android:layout_height="@dimen/plugin_dividing_line_height"
                    android:layout_marginTop="@dimen/plugin_dividing_line_marginTop"
                    android:layerType="software"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/game_assist_plugins_container"
                android:layout_width="@dimen/game_assist_plugins_width"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/layout_switch_mode_plugin_marginStart"
                android:layout_marginTop="@dimen/game_assist_plugins_container_marginTop"
                android:layout_marginBottom="@dimen/item_tile_plugin_margin_top"
                android:layout_below="@+id/layout_switch_mode_plugin"
                android:layout_alignParentLeft="true"
                android:layout_alignParentBottom="true">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/game_assist_plugins_list"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/game_assist_plugins_card"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/game_assist_bright_seekbar_group"
                android:paddingLeft="15dp"
                android:paddingTop="20dp"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="386dp"
                android:layout_toRightOf="@+id/game_assist_plugins_container"
                android:layout_alignParentTop="true">
                <cn.nubia.gameassist.view.StairSeekBar
                    android:id="@+id/game_assist_bright_seekbar"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:layout_marginLeft="2dp"
                    android:layout_marginBottom="1dp"
                    android:layout_weight="1"
                    app:align="align_left"
                    app:stair_count="15"/>
                <ImageView
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_marginLeft="-3dp"
                    android:src="@drawable/game_assist_bright_icon"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/game_assist_cpu_neon_lamp"
                android:layout_width="400dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="142dp"
                android:layout_alignParentLeft="true"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/game_assist_cup_effect"
                android:paddingLeft="90dp"
                android:paddingTop="122dp"
                android:paddingRight="90dp"
                android:paddingBottom="90dp"
                android:layout_width="345dp"
                android:layout_height="345dp"
                android:layout_marginLeft="-70dp"
                android:layout_marginTop="-50dp"
                android:layout_toRightOf="@+id/game_assist_plugins_container"
                android:layout_below="@+id/game_assist_buttons"
                android:layout_alignTop="@+id/game_assist_plugins"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/game_assist_cpu_launch"
                android:layout_width="550dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="10dp"
                android:layout_alignParentLeft="true"/>
            <FrameLayout
                android:orientation="vertical"
                android:id="@+id/game_assist_performance_effect_legacy"
                android:paddingRight="8dp"
                android:layout_width="198dp"
                android:layout_height="198dp"
                android:layout_marginLeft="170dp"
                android:layout_marginTop="308dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true">
                <include layout="@layout/game_assist_performance_effect_show_legacy"/>
            </FrameLayout>
            <FrameLayout
                android:orientation="vertical"
                android:id="@+id/game_assist_performance_effect"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_marginLeft="120dp"
                android:layout_marginTop="308dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true">
                <include layout="@layout/game_assist_performance_effect_show"/>
            </FrameLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/game_assist_right_panel"
            android:layout_width="660dp"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/game_assist_pips"
                android:paddingLeft="13dp"
                android:paddingTop="4dp"
                android:paddingRight="13dp"
                android:layout_width="360dp"
                android:layout_height="90dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true">
                <include layout="@layout/game_assist_right_panel_pip_buttons"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/game_assist_recycler_group"
                android:layout_width="183dp"
                android:layout_height="match_parent"
                android:layout_marginTop="5dp"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="@dimen/item_tile_plugin_margin_top"
                android:minWidth="225dp"
                android:layout_below="@+id/game_assist_pips"
                android:layout_alignParentRight="true">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/game_assist_dessert"
                    android:layout_width="174dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="9dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/game_assist_pip_recycler"
                    android:visibility="gone"
                    android:layout_width="174dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="9dp"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/game_assist_volume_seekbar_group"
                android:paddingTop="20dp"
                android:paddingRight="15dp"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="386dp"
                android:layout_marginRight="40dp"
                android:layout_toLeftOf="@+id/game_assist_recycler_group"
                android:layout_alignParentTop="true">
                <cn.nubia.gameassist.view.StairSeekBar
                    android:id="@+id/game_assist_volume_seekbar"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:layout_marginRight="2dp"
                    android:layout_marginBottom="1dp"
                    android:layout_weight="1"
                    app:align="align_right"
                    app:stair_count="15"/>
                <ImageView
                    android:layout_gravity="right"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_marginRight="-3dp"
                    android:src="@drawable/game_assist_volume_icon"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/game_assist_gpu_neon_lamp"
                android:layout_width="400dp"
                android:layout_height="match_parent"
                android:layout_marginRight="142dp"
                android:layout_alignParentRight="true"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/game_assist_gpu_effect"
                android:paddingLeft="90dp"
                android:paddingTop="122dp"
                android:paddingRight="90dp"
                android:paddingBottom="90dp"
                android:layout_width="345dp"
                android:layout_height="345dp"
                android:layout_marginTop="-55dp"
                android:layout_marginRight="-70dp"
                android:layout_toLeftOf="@+id/game_assist_recycler_group"
                android:layout_below="@+id/game_assist_pips"
                android:layout_alignTop="@+id/game_assist_recycler_group"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/game_assist_gpu_launch"
                android:layout_width="550dp"
                android:layout_height="match_parent"
                android:layout_marginRight="10dp"
                android:layout_alignParentRight="true"/>
            <FrameLayout
                android:id="@+id/game_assist_meditation_mode"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_marginTop="308dp"
                android:layout_marginRight="120dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true">
                <include layout="@layout/game_assist_meditation_show"/>
            </FrameLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/game_assist_middle_panel"
            android:layout_width="540dp"
            android:layout_height="90dp"
            android:layout_marginBottom="-3dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true">
            <include layout="@layout/game_assist_middle_sub"/>
        </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/game_assist_root_vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/game_assist_left_panel"
            android:layout_width="match_parent"
            android:layout_height="660dp"
            android:layout_alignParentTop="true"
            android:layout_centerVertical="true">
            <LinearLayout
                android:gravity="top|center_horizontal"
                android:orientation="vertical"
                android:id="@+id/game_assist_buttons"
                android:layout_width="90dp"
                android:layout_height="360dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true">
                <include layout="@layout/game_assist_left_panel_sub_buttons"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layout_switch_mode_plugin"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_switch_mode_plugin_port_marginTop"
                android:layout_toLeftOf="@+id/game_assist_buttons"
                android:layout_marginEnd="@dimen/layout_switch_mode_plugin_port_marginEnd">
                <View
                    android:background="@drawable/dividing_line_plugin_port"
                    android:layout_width="@dimen/plugin_dividing_line_height"
                    android:layout_height="@dimen/plugin_dividing_line_width_port"
                    android:layout_marginBottom="@dimen/layout_switch_mode_plugin_port_marginEnd"
                    android:layerType="software"
                    android:layout_marginEnd="@dimen/layout_switch_mode_plugin_port_marginEnd"/>
                <include layout="@layout/layout_switch_mode_plugin_port"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/game_assist_plugins_container"
                android:layout_width="match_parent"
                android:layout_height="@dimen/game_assist_plugins_width_port"
                android:layout_marginTop="@dimen/layout_switch_mode_plugin_port_marginTop"
                android:layout_toLeftOf="@+id/layout_switch_mode_plugin"
                android:layout_alignParentTop="true">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/game_assist_plugins_list"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/game_assist_plugins_card"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/game_assist_bright_seekbar_group"
                android:paddingTop="15dp"
                android:paddingRight="20dp"
                android:layout_width="wrap_content"
                android:layout_height="90dp"
                android:layout_marginTop="40dp"
                android:layout_marginRight="280dp"
                android:layout_toLeftOf="@+id/game_assist_buttons"
                android:layout_below="@+id/game_assist_plugins_container">
                <ImageView
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_marginTop="-3dp"
                    android:src="@drawable/game_assist_bright_icon"/>
                <cn.nubia.gameassist.view.StairSeekBar
                    android:id="@+id/game_assist_bright_seekbar"
                    android:layout_width="125dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="3dp"
                    android:layout_weight="1"
                    app:align="align_top"
                    app:stair_count="15"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/game_assist_cpu_neon_lamp"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:layout_marginTop="142dp"
                android:layout_alignParentTop="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/game_assist_cup_effect"
                android:paddingLeft="90dp"
                android:paddingTop="122dp"
                android:paddingRight="90dp"
                android:paddingBottom="90dp"
                android:layout_width="345dp"
                android:layout_height="345dp"
                android:layout_marginTop="-75dp"
                android:layout_marginRight="-45dp"
                android:layout_toLeftOf="@+id/game_assist_buttons"
                android:layout_below="@+id/game_assist_plugins_container"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/game_assist_cpu_launch"
                android:layout_width="match_parent"
                android:layout_height="550dp"
                android:layout_marginTop="10dp"
                android:layout_alignParentTop="true"/>
            <cn.nubia.gameassist.view.RotationFrameLayout
                android:id="@+id/game_assist_performance_effect_legacy"
                android:layout_width="198dp"
                android:layout_height="198dp"
                android:layout_marginTop="170dp"
                android:layout_marginRight="308dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true">
                <FrameLayout
                    android:orientation="vertical"
                    android:id="@+id/show_view"
                    android:paddingRight="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <include layout="@layout/game_assist_performance_effect_show_legacy"/>
                </FrameLayout>
                <FrameLayout
                    android:orientation="vertical"
                    android:id="@+id/click_view"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <include layout="@layout/game_assist_performance_effect_click_legacy"/>
                </FrameLayout>
            </cn.nubia.gameassist.view.RotationFrameLayout>
            <cn.nubia.gameassist.view.RotationFrameLayout
                android:id="@+id/game_assist_performance_effect"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_marginTop="120dp"
                android:layout_marginRight="308dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true">
                <FrameLayout
                    android:orientation="vertical"
                    android:id="@+id/show_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <include layout="@layout/game_assist_performance_effect_show"/>
                </FrameLayout>
                <FrameLayout
                    android:orientation="vertical"
                    android:id="@+id/click_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <include layout="@layout/game_assist_performance_effect_click"/>
                </FrameLayout>
            </cn.nubia.gameassist.view.RotationFrameLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/game_assist_right_panel"
            android:layout_width="match_parent"
            android:layout_height="660dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true">
            <LinearLayout
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical"
                android:id="@+id/game_assist_pips"
                android:layout_width="90dp"
                android:layout_height="360dp"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true">
                <include layout="@layout/game_assist_right_panel_pip_buttons"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/game_assist_recycler_group"
                android:layout_width="match_parent"
                android:layout_height="168dp"
                android:layout_marginLeft="9dp"
                android:layout_marginBottom="15dp"
                android:layout_toLeftOf="@+id/game_assist_pips"
                android:layout_alignParentBottom="true">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/game_assist_dessert"
                    android:layout_width="match_parent"
                    android:layout_height="174dp"
                    android:layout_marginTop="9dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/game_assist_pip_recycler"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="174dp"
                    android:layout_marginTop="9dp"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/game_assist_volume_seekbar_group"
                android:paddingRight="20dp"
                android:paddingBottom="15dp"
                android:layout_width="wrap_content"
                android:layout_height="90dp"
                android:layout_marginRight="280dp"
                android:layout_marginBottom="40dp"
                android:layout_toLeftOf="@+id/game_assist_pips"
                android:layout_above="@+id/game_assist_recycler_group">
                <ImageView
                    android:layout_gravity="bottom"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_marginBottom="-3dp"
                    android:src="@drawable/game_assist_volume_icon"/>
                <cn.nubia.gameassist.view.StairSeekBar
                    android:id="@+id/game_assist_volume_seekbar"
                    android:layout_width="125dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="1dp"
                    android:layout_marginBottom="3dp"
                    app:align="align_bottom"
                    app:stair_count="15"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/game_assist_gpu_neon_lamp"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:layout_marginBottom="142dp"
                android:layout_alignParentBottom="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/game_assist_gpu_effect"
                android:paddingLeft="90dp"
                android:paddingTop="122dp"
                android:paddingRight="90dp"
                android:paddingBottom="90dp"
                android:layout_width="345dp"
                android:layout_height="345dp"
                android:layout_marginRight="-45dp"
                android:layout_marginBottom="-50dp"
                android:layout_toLeftOf="@+id/game_assist_pips"
                android:layout_above="@+id/game_assist_recycler_group"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/game_assist_gpu_launch"
                android:layout_width="match_parent"
                android:layout_height="550dp"
                android:layout_marginBottom="10dp"
                android:layout_alignParentBottom="true"/>
            <cn.nubia.gameassist.view.RotationFrameLayout
                android:id="@+id/game_assist_meditation_mode"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_marginRight="308dp"
                android:layout_marginBottom="120dp"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true">
                <FrameLayout
                    android:orientation="vertical"
                    android:id="@+id/show_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <include layout="@layout/game_assist_meditation_show"/>
                </FrameLayout>
                <FrameLayout
                    android:orientation="vertical"
                    android:id="@+id/click_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <include layout="@layout/game_assist_meditation_click"/>
                </FrameLayout>
            </cn.nubia.gameassist.view.RotationFrameLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/game_assist_middle_panel"
            android:layout_width="match_parent"
            android:layout_height="135dp"
            android:layout_marginTop="70dp"
            android:layout_centerInParent="true">
            <include layout="@layout/game_assist_middle_sub"/>
        </RelativeLayout>
    </RelativeLayout>
</FrameLayout>
