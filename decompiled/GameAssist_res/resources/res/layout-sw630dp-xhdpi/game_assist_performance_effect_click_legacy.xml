<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="top|right"
        android:orientation="horizontal"
        android:id="@+id/game_assist_performance_effect_expand"
        android:paddingLeft="20dp"
        android:visibility="gone"
        android:layout_width="160dp"
        android:layout_height="match_parent"
        android:layout_marginRight="21dp">
        <View
            android:id="@+id/game_assist_performance_effect_expand_awakening"
            android:layout_width="0dp"
            android:layout_height="114dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"/>
        <View
            android:id="@+id/game_assist_performance_effect_expand_balance"
            android:layout_width="0dp"
            android:layout_height="114dp"
            android:layout_marginTop="24dp"
            android:layout_weight="1"/>
        <View
            android:id="@+id/game_assist_performance_effect_expand_economize"
            android:layout_width="0dp"
            android:layout_height="114dp"
            android:layout_marginTop="48dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <View
        android:layout_gravity="bottom|right"
        android:id="@+id/game_assist_performance_effect_button"
        android:layout_width="45dp"
        android:layout_height="120dp"/>
</merge>
