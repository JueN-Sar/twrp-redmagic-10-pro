<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#ff0a0b12"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="top|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/screen_extraction_table_parent"
        android:layout_width="wrap_content"
        android:layout_height="360dp"
        android:layout_marginTop="198dp">
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/screen_extraction_view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="bottom|center_horizontal"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16.2dp"
            android:id="@+id/screen_extraction_done"
            android:background="@drawable/screen_extraction_help_button_bg"
            android:clickable="true"
            android:layout_width="189dp"
            android:layout_height="40.5dp"
            android:text="@string/nubia_game_assist_guide_done"
            style="@style/TitleTextStyle"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="13.5dp"
            android:layout_marginBottom="32.4dp">
            <View
                android:id="@+id/screen_extraction_indicator_0"
                android:background="@drawable/screen_extraction_indicator_red_bg"
                android:layout_width="18.9dp"
                android:layout_height="5.4dp"
                android:layout_margin="0.9dp"/>
            <View
                android:id="@+id/screen_extraction_indicator_1"
                android:background="@drawable/screen_extraction_indicator_blue_bg"
                android:layout_width="18.9dp"
                android:layout_height="5.4dp"
                android:layout_margin="0.9dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
