<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#ff0a0b12"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="top|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/screen_extraction_table_parent"
        android:layout_width="wrap_content"
        android:layout_height="400dp"
        android:layout_marginTop="220dp">
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/screen_extraction_view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="bottom|center_horizontal"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18dp"
            android:id="@+id/screen_extraction_done"
            android:background="@drawable/screen_extraction_help_button_bg"
            android:clickable="true"
            android:layout_width="210dp"
            android:layout_height="45dp"
            android:text="@string/nubia_game_assist_guide_done"
            style="@style/TitleTextStyle"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="36dp">
            <View
                android:id="@+id/screen_extraction_indicator_0"
                android:background="@drawable/screen_extraction_indicator_red_bg"
                android:layout_width="21dp"
                android:layout_height="6dp"
                android:layout_margin="1dp"/>
            <View
                android:id="@+id/screen_extraction_indicator_1"
                android:background="@drawable/screen_extraction_indicator_blue_bg"
                android:layout_width="21dp"
                android:layout_height="6dp"
                android:layout_margin="1dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
